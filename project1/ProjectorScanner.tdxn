options:
  include_dat_content: false
  include_storage: true
type_defaults:
  buttonCOMP:
    parameters:
      bottomanchor: 1
      bottomoffset: -36
      buttontype: momentary
      clone: =op.TDTox.op('defaultCOMPs/button')
      hmode: anchors
      repocomp: =me
      resizecomp: =me
      vmode: anchors
    size: [160, 134]
  outCHOP:
    parameters:
      autoexportroot: =parent()
      label: =me.name
    flags:
    - viewer
    size: [130, 90]
  panelexecuteDAT:
    parameters:
      fromop: =parent()
  parameterCHOP:
    parameters:
      autoexportroot: =parent()
      builtin: true
      custom: false
      parameters: value0
      renameto: v1
    flags:
    - viewer
    size: [130, 90]
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
      op: ..
    flags:
    - viewer
  tableDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    tags:
    - tdxn_exclude:dat_content
  textCOMP:
    parameters:
      bgalpha: 1
      bgcolorb: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorb + r * 0.1
      bgcolorg: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorg + r * 0.1
      bgcolorr: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorr + r * 0.1
      borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorb + .2
      borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorg + .2
      borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorr + .2
      borderover: false
      bottomborder: bordera
      clickthrough: true
      fontcolorb: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorb + .5
      fontcolorg: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorg + .5
      fontcolorr: =[c/.5 for c in [.1, .3]][parent().par.value0] * parent().par.colorr + .5
      fontsize: =parent().par[me.curPar.name] or me.curPar.val
      hmode: fill
      leftborder: bordera
      legacyfontselection: true
      linespacing: =parent().par[me.curPar.name] or me.curPar.val
      repocomp: =me
      resizecomp: =me
      rightborder: bordera
      scaletofit: =parent().par[me.curPar.name] or me.curPar.val
      text: =parent().par.label
      textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
      textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
      textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
      textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
      topborder: bordera
      type: multiline
      vmode: fill
    flags:
    - viewer
    size: [113, 96]
  textDAT:
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Discovery:
  - name: Scannow
    style: Pulse
    label: Scan Now
    help: Sweep the subnet now and list every PJLink projector found.
  - name: Subnet
    style: Str
    label: Subnet Override
    startSection: true
    help: First three octets to scan, e.g. '192.168.50'. Leave blank to auto-detect this machine's own /24 subnet.
    value: 192.168.50
  - name: Port
    style: Int
    label: PJLink Port
    default: 4352
    min: 1.0
    max: 65535.0
    clampMin: true
    clampMax: true
    help: PJLink TCP port. Standard is 4352; change only for a nonstandard install.
  - name: Timeoutms
    style: Int
    label: Per-Host Timeout (ms)
    default: 350
    min: 50.0
    max: 5000.0
    clampMin: true
    normMin: 100.0
    normMax: 1000.0
    help: Connect/read timeout per host during a scan, in milliseconds. Higher catches slow devices.
    value: 800
  - name: Concurrency
    style: Int
    label: Parallel Probes
    default: 64
    min: 1.0
    max: 256.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 128.0
    help: How many hosts are probed at once during a scan. 64 sweeps a /24 in a few seconds.
  - name: Status
    style: Str
    startSection: true
    readOnly: true
    help: Live scan/power progress and result summary (read-only).
  - name: Password
    style: Str
    label: PJLink Password
    help: Control password if the projector requires PJLink authentication (PJLINK 1). Leave blank for none.
  - name: Autorefresh
    style: Toggle
    label: Auto-Refresh Power
    startSection: true
    default: true
    help: Periodically re-query power state so the list reflects changes made outside this panel (e.g. the projector switched off at the unit).
  - name: Refreshsecs
    style: Int
    label: Refresh Interval (s)
    default: 15
    min: 3.0
    max: 300.0
    clampMin: true
    normMin: 5.0
    normMax: 60.0
    help: Seconds between automatic power-state refreshes.
  - name: Lampsecs
    style: Int
    label: Lamp Refresh (s)
    default: 300
    min: 30.0
    max: 3600.0
    clampMin: true
    normMin: 60.0
    normMax: 900.0
    help: Seconds between automatic lamp-hour refreshes. Lamp hours change slowly, so keep this longer than the power refresh.
