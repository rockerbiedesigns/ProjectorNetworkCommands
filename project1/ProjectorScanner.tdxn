    - name: text
      type: textCOMP
      parameters:
        text: =parent().par.label
        type: multiline
        legacyfontselection: true
        scaletofit: =parent().par[me.curPar.name] or me.curPar.val
        fontsize: =parent().par[me.curPar.name] or me.curPar.val
