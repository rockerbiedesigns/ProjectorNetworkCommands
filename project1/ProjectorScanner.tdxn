    dat_content: |
      # Top-row buttons: Scan / Selected On / Selected Off. Dispatch by which one.

      def onOffToOn(panelValue):
          name = panelValue.owner.name
          ps = parent.ProjectorScanner
          if name == 'scan_btn':
              ps.Scan()
          elif name == 'selon_btn':
              ps.PowerSelected(True)
          elif name == 'seloff_btn':
              ps.PowerSelected(False)
          return
    dat_content_format: text
