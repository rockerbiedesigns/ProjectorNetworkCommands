      dat_content_format: text
  - name: ip_list_callbacks
    type: textDAT
    parameters:
      language: python
    flags:
    - viewer
    - -showDocked
    position: [240, 40]
    size: [160, 130]
    dock: ip_list
    dat_content: |
      # List COMP callbacks. Seven columns from ../ip_display:
      #   col 0 = Sel    (selection checkbox: '[x]'/'[ ]', click to toggle selection)
      #   col 1 = Power  (ON/OFF/COOL/WARM/? , '...' busy, 'OFF?' confirm; click to toggle)
      #   col 2 = IP Address   col 3 = Name   col 4 = Maker   col 5 = Unit   col 6 = Lamp Hrs
      # Row 0 is the styled header.

      def onInitCell(comp, row, col, attribs):
          src = comp.op('../ip_display')
          text = ''
          if src is not None and row < src.numRows and col < src.numCols:
              text = src[row, col].val
          attribs.text = text
          attribs.rowHeight = 28

          if row == 0:
              attribs.bgColor = [0.16, 0.17, 0.22, 1.0]
              attribs.textColor = [0.86, 0.90, 0.98, 1.0]
              attribs.fontBold = True
              attribs.textJustify = JustifyType.CENTER if col in (0, 1) else JustifyType.CENTERLEFT
              return

          if col == 0:
              # selection checkbox
              attribs.textJustify = JustifyType.CENTER
              attribs.fontBold = True
              if text.strip() == '[x]':
                  attribs.bgColor = [0.20, 0.42, 0.58, 1.0]
                  attribs.textColor = [0.90, 0.98, 1.0, 1.0]
              else:
                  attribs.bgColor = [0.13, 0.14, 0.17, 1.0]
                  attribs.textColor = [0.48, 0.50, 0.56, 1.0]
              if attribs.rollover:
                  bg = attribs.bgColor
                  attribs.bgColor = [min(1.0, bg[0] + 0.10), min(1.0, bg[1] + 0.10),
                                     min(1.0, bg[2] + 0.10), 1.0]
              return

          if col == 1:
              # power state / toggle
              attribs.textJustify = JustifyType.CENTER
              attribs.fontBold = True
              state = text.upper()
              if text == '...':
                  attribs.bgColor = [0.18, 0.19, 0.22, 1.0]
                  attribs.textColor = [0.60, 0.62, 0.68, 1.0]
              elif text == 'OFF?':
                  attribs.bgColor = [0.55, 0.33, 0.06, 1.0]
                  attribs.textColor = [1.0, 0.96, 0.86, 1.0]
              elif state == 'ON':
                  attribs.bgColor = [0.12, 0.42, 0.20, 1.0]
                  attribs.textColor = [0.85, 1.0, 0.88, 1.0]
              elif state == 'OFF':
                  attribs.bgColor = [0.42, 0.14, 0.16, 1.0]
                  attribs.textColor = [1.0, 0.86, 0.86, 1.0]
              elif state in ('COOL', 'WARM'):
                  attribs.bgColor = [0.42, 0.34, 0.10, 1.0]
                  attribs.textColor = [1.0, 0.95, 0.80, 1.0]
              else:
                  attribs.bgColor = [0.20, 0.21, 0.25, 1.0]
                  attribs.textColor = [0.72, 0.74, 0.80, 1.0]
              if attribs.rollover and text != '...':
                  bg = attribs.bgColor
                  attribs.bgColor = [min(1.0, bg[0] + 0.10), min(1.0, bg[1] + 0.10),
                                     min(1.0, bg[2] + 0.10), 1.0]
              return

          # info columns (2..6)
          attribs.textJustify = JustifyType.CENTERLEFT
          attribs.textOffsetX = 12
          attribs.textColor = [0.90, 0.95, 1.0, 1.0]
          attribs.bgColor = [0.115, 0.125, 0.150, 1.0] if row % 2 else [0.140, 0.150, 0.180, 1.0]
          if attribs.rollover:
              attribs.bgColor = [0.20, 0.26, 0.36, 1.0]
          return


      def onInitCol(comp, col, attribs):
          fixed = {0: 42, 1: 56, 2: 120, 3: 110, 4: 80, 6: 74}   # Sel,Power,IP,Name,Maker,Lamp
          if col in fixed:
              attribs.colWidth = fixed[col]
          else:                                                   # col 5 = Unit -- stretches
              attribs.colWidth = 150
              try:
                  attribs.colStretch = True
              except Exception:
                  pass
          return


      def onSelect(comp, startRow, startCol, startCoords, endRow, endCol, endCoords, start, end):
          # single-cell clicks on data rows: col 0 toggles selection, col 1 toggles power
          if startRow == endRow and startCol == endCol and startRow > 0:
              src = comp.op('../ip_display')
              if src is None or startRow >= src.numRows:
                  return
              ip = src[startRow, 2].val   # IP Address is column 2
              if not ip:
                  return
              ext = parent.ProjectorScanner.ext.ProjectorScanner
              if startCol == 0:
                  ext.ToggleSelect(ip)
              elif startCol == 1:
                  ext.TogglePower(ip)
          return
    dat_content_format: text
- name: tcpip1
  type: tcpipDAT
  parameters:
    active: false
    address: 192.168.50.190
    port: 4352
    callbacks: tcpip1_callbacks
    fromop: =parent()
  flags:
  - viewer
  position: [925, 100]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_read_only: true
- name: parexec
  type: parameterexecuteDAT
  parameters:
    pars: '*'
    valuechange: false
    builtin: false
  position: [200, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    # Routes custom-parameter pulses on the ProjectorScanner COMP to the extension.
    # One dispatcher, not one promoted method per parameter: a pulse on 'Scannow'
    # calls the extension's _onScannowPulse handler.

    def onPulse(par):
        comp = par.owner
        ext = comp.ext.ProjectorScanner
        handler = getattr(ext, '_on%sPulse' % par.name, None)
        if handler is None:
            return
        try:
            handler(par)
        except Exception as e:
            debug('ProjectorScanner: pulse handler for %s failed: %s' % (par.name, e))
        return
  dat_content_format: text
- name: execScan
  type: executeDAT
  parameters:
    fromop: =parent()
  flags:
  - viewer
  position: [200, -200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    # Per-frame drain for the background subnet scan. The extension arms this
    # (Frame Start on) only while a scan is running and disarms it when finished,
    # so there is no idle per-frame cost.

    def onFrameStart(frame):
        parent().ext.ProjectorScanner.pumpResults()
        return
  dat_content_format: text
- name: projectors
  type: tableDAT
  position: [620, 200]
- name: scan_results
  type: tableDAT
  position: [620, 0]
- name: refresh_timer
  type: timerCHOP
  parameters:
    length: =parent.ProjectorScanner.par.Refreshsecs
    cycle: true
    cyclelimit: false
    callbacks: refresh_timer_callbacks
    exttcop: =tdu.Timecode()
    rate: =me.time.rate
    autoexportroot: =parent()
  position: [200, -440]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: tcpip1_callbacks
  type: textDAT
  parameters:
    language: python
  flags:
  - bypass
  - viewer
  - -showDocked
  position: [925, -20]
  size: [130, 90]
  dock: tcpip1
  dat_content: |
    # tcpip1 is not used for PJLink commands -- power control uses reliable
    # background-socket transactions in ProjectorScannerExt (PJLink allows only one
    # connection at a time and the TCP/IP DAT's reconnect churn breaks that).
    # These stubs are kept so the DAT never raises if it is ever activated.

    def onConnect(dat, peer):
        return

    def onReceive(dat, rowIndex, message, byteData, peer):
        return

    def onClose(dat, peer):
        return
  dat_content_format: text
- name: ProjectorScannerExt
  type: textDAT
  flags:
  - viewer
  position: [200, 200]
  size: [130, 90]
  dat_content: |
    from __future__ import annotations
    import socket
    import threading
    import queue
    import time
    from concurrent.futures import ThreadPoolExecutor, as_completed
    from typing import Optional, List, Dict

    # PJLink %1POWR status codes -> short UI labels.
    POWER_LABEL = {'1': 'ON', '0': 'OFF', '2': 'COOL', '3': 'WARM', '?': '?', 'ERR': 'ERR'}

    # OFF-confirm window and COOL/WARM transition-poll cadence.
    CONFIRM_S = 3.0        # seconds to click again to confirm a power-OFF
    CONFIRM_FRAMES = 180   # ~3s at 60fps -- auto-disarm the confirm prompt
    POLL_FRAMES = 300      # ~5s between COOL/WARM re-queries
    POLL_MAX = 60          # stop transition polling after ~5 min


    class ProjectorScannerExt:
        """Discover PJLink projectors on the local /24 and control their power.

        DISCOVERY: a projector speaking PJLink listens on TCP 4352 and, the instant a
        client connects, sends 'PJLINK 0' (no auth) or 'PJLINK 1 <seed>' (auth). The
        254-host sweep is blocking socket work, so it runs on a background worker
        thread that touches ZERO TouchDesigner objects and hands data back to a
        main-thread drain (pumpResults).

        POWER: PJLink allows ONE connection at a time and expects a tight
        connect -> banner -> command -> reply -> close sequence. So power commands run
        as serialized background-socket transactions (one shared lock => one live
        connection ever) and report back through the same main-thread drain. The
        TCP/IP DAT is deliberately NOT used here: its frame-delayed callbacks and
        auto-reconnect churn the projector's single connection slot.

        The wire protocols themselves live in pure modules drivers/transports.py
        (socket transactions) and drivers/parsers.py (reply parsers), loaded by path
        in _ensureDrivers and dispatched by name in the worker -- no protocol code
        lives in this extension, so a new vendor's adapter never touches it."""

        def __init__(self, ownerComp: COMP) -> None:
            self.ownerComp = ownerComp
            # discovery worker plumbing
            self._resultQ: "queue.Queue" = queue.Queue()
            self._progressQ: "queue.Queue" = queue.Queue()
            self._thread: Optional[threading.Thread] = None
            self._scanning: bool = False
            self._total: int = 0
            self._done: int = 0
            # power control plumbing
            self._power: Dict[str, str] = {}             # ip -> PJLink POWR code
            self._powerResultQ: "queue.Queue" = queue.Queue()
            self._pjPending: int = 0                     # in-flight power jobs
            self._pjLock = threading.Lock()              # one PJLink connection at a time
            self._toggleGuard: Dict[str, float] = {}     # ip -> last toggle monotonic
            self._pjBusyIps = set()                      # ips with a power command in flight
            self._confirmOff: Dict[str, float] = {}      # ip -> OFF-confirm armed monotonic
            self._pollCount: Dict[str, int] = {}         # ip -> COOL/WARM poll count
            # Static-ish info persists in storage so it survives an extension reinit.
            # (Only a scan re-fetches it; auto-refresh does not -- without this it
            # blanks to '?' after every source save/reinit.) Power is deliberately NOT
            # persisted: it is volatile and self-heals via auto-refresh in ~15s.
            self._model = dict(self.ownerComp.fetch('info_model', {}))   # ip -> model / product name
            self._maker = dict(self.ownerComp.fetch('info_maker', {}))   # ip -> manufacturer name
            self._name = dict(self.ownerComp.fetch('info_name', {}))     # ip -> user-set name
            self._lamp = dict(self.ownerComp.fetch('info_lamp', {}))     # ip -> lamp hour count(s)
            self._lastLampRefresh: float = 0.0           # monotonic of last lamp-hours poll
            self._selected = set()                       # ips ticked for bulk on/off
            self._selGuard: Dict[str, float] = {}        # ip -> last select-toggle monotonic
            self._pclass = dict(self.ownerComp.fetch('info_class', {}))  # ip -> PJLink class
            self._drivers = None                         # DriverManager (lazy; see _ensureDrivers)
            self._parserFns: Dict = {}                   # parse name -> callable (from drivers/parsers.py)
            self._transportFns: Dict = {}                # transport type -> callable (from drivers/transports.py)
            self._actionResults: Dict[str, Dict] = {}    # ip -> {dest: value} for generic actions

        # ---- lifecycle ----------------------------------------------------------

        def onInitTD(self) -> None:
            self._ensurePars()
            if not self._scanning and self._pjPending <= 0:
                self._disarmDrain()
            dat = self.ownerComp.op('tcpip1')
            if dat is not None:
                try:
                    dat.par.active = False   # not used for commands; keep it quiet
                except Exception:
                    pass
            self._refreshIpDisplay()
            self._ensureUi()
            self._updateUiState()
            run(self._startTimer, delayFrames=15)   # auto-start the refresh timer
            run(self._autoRefresh, delayFrames=30)  # refresh power soon so it isn't '?' for a full interval

        def onDestroyTD(self) -> None:
            self._disarmDrain()

        # ---- parameter provisioning (get-or-create) -----------------------------

        def _ensurePars(self) -> None:
            comp = self.ownerComp
            page = None
            for p in comp.customPages:
                if p.name == 'Discovery':
                    page = p
                    break
            if page is None:
                page = comp.appendCustomPage('Discovery')

            def ensure(name: str, style: str, **attrs):
                found = [p for p in comp.customPars if p.tupletName == name]
                created = False
                if not found:
                    getattr(page, 'append' + style)(name)
                    found = [p for p in comp.customPars if p.tupletName == name]
                    created = True
                for p in found:
                    for k, v in attrs.items():
                        if k not in ('val', 'expr', 'bindExpr', 'mode', 'export'):
                            setattr(p, k, v)
                return found[0], created

            ensure('Scannow', 'Pulse', label='Scan Now',
                   help='Sweep the subnet now and list every PJLink projector found.')

            p, new = ensure('Subnet', 'Str', label='Subnet Override',
                            help="First three octets to scan, e.g. '192.168.50'. Leave "
                                 "blank to auto-detect this machine's own /24 subnet.")
            if new:
                p.startSection = True

            p, new = ensure('Port', 'Int', label='PJLink Port',
                            help='PJLink TCP port. Standard is 4352; change only for a '
                                 'nonstandard install.')
            if new:
                p.default = 4352
                p.min = 1
                p.max = 65535
                p.clampMin = True
                p.clampMax = True
                p.val = 4352

            p, new = ensure('Password', 'Str', label='PJLink Password',
                            help='Control password if the projector requires PJLink '
                                 'authentication (PJLINK 1). Leave blank for none.')

            p, new = ensure('Timeoutms', 'Int', label='Per-Host Timeout (ms)',
                            help='Connect/read timeout per host during a scan, in '
                                 'milliseconds. Higher catches slow devices.')
            if new:
                p.default = 350
                p.min = 50
                p.max = 5000
                p.clampMin = True
                p.normMin = 100
                p.normMax = 1000
                p.val = 350

            p, new = ensure('Concurrency', 'Int', label='Parallel Probes',
                            help='How many hosts are probed at once during a scan. 64 '
                                 'sweeps a /24 in a few seconds.')
            if new:
                p.default = 64
                p.min = 1
                p.max = 256
                p.clampMin = True
                p.clampMax = True
                p.normMin = 1
                p.normMax = 128
                p.val = 64

            p, new = ensure('Autorefresh', 'Toggle', label='Auto-Refresh Power',
                            help='Periodically re-query power state so the list reflects '
                                 'changes made outside this panel (e.g. the projector '
                                 'switched off at the unit).')
            if new:
                p.startSection = True
                p.default = 1
                p.val = 1

            p, new = ensure('Refreshsecs', 'Int', label='Refresh Interval (s)',
                            help='Seconds between automatic power-state refreshes.')
            if new:
                p.default = 15
                p.min = 3
                p.max = 300
                p.clampMin = True
                p.normMin = 5
                p.normMax = 60
                p.val = 15

            p, new = ensure('Lampsecs', 'Int', label='Lamp Refresh (s)',
                            help='Seconds between automatic lamp-hour refreshes. Lamp hours change slowly, so keep this longer than the power refresh.')
            if new:
                p.default = 300
                p.min = 30
                p.max = 3600
                p.clampMin = True
                p.normMin = 60
                p.normMax = 900
                p.val = 300

            p, new = ensure('Status', 'Str', label='Status',
                            help='Live scan/power progress and result summary (read-only).')
            p.readOnly = True
            if new:
                p.startSection = True
                p.val = 'Idle. Press Scan Now.'

        # ---- drain arming (shared by discovery + power) -------------------------

        def _armDrain(self) -> None:
            ex = self.ownerComp.op('execScan')
            if ex is not None:
                ex.par.active = True
                ex.par.framestart = True

        def _disarmDrain(self) -> None:
            ex = self.ownerComp.op('execScan')
            if ex is not None:
                ex.par.framestart = False

        def _ensureUi(self) -> None:
            """One-time UI look setup: the Scan button greys when disabled."""
            btn = self.ownerComp.op('ui/scan_btn')
            if btn is not None:
                try:
                    btn.par.dodisablecolor = True
                    btn.par.disablecolorr = 0.12
                    btn.par.disablecolorg = 0.13
                    btn.par.disablecolorb = 0.15
                    btn.par.disablealpha = 0.80
                except Exception:
                    pass

        def _updateUiState(self) -> None:
            """Reflect busy state via opacity + label. Buttons stay ENABLED --
            disabling a buttonCOMP (enable=0) makes its own internal PanelValue sync
            raise 'PanelValue is disabled'. Clicks while busy are refused by the
            extension, so no functional gate is lost."""
            busy = self._scanning or self._pjPending > 0
            scan = self.ownerComp.op('ui/scan_btn')
            if scan is not None:
                try:
                    scan.par.enable = 1
                    scan.par.opacity = 0.5 if busy else 1.0
                    if self._scanning:
                        scan.par.label = 'Scanning...'
                    elif self._pjPending > 0:
                        scan.par.label = 'Working...'
                    else:
                        scan.par.label = 'Scan'
                except Exception:
                    pass
            for name in ('selon_btn', 'seloff_btn'):
                b = self.ownerComp.op('ui/' + name)
                if b is not None:
                    try:
                        b.par.enable = 1
                        b.par.opacity = 0.5 if busy else 1.0
                    except Exception:
                        pass

        def _startTimer(self) -> None:
            """Start the auto-refresh timer (free-runs; _autoRefresh gates on the toggle)."""
            t = self.ownerComp.op('refresh_timer')
            if t is not None:
                try:
                    t.par.start.pulse()
                except Exception:
                    pass

        def _setStatus(self, text: str) -> None:
            self.ownerComp.par.Status = text

        def _hostList(self) -> List[str]:
            override = str(self.ownerComp.par.Subnet.eval()).strip()
            if override:
                base = override.rstrip('.')
            else:
                base = '.'.join(self._localIp().split('.')[:3])
            return ['%s.%d' % (base, i) for i in range(1, 255)]

        def _localIp(self) -> str:
            ip = '127.0.0.1'
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            try:
                s.settimeout(0.2)
                s.connect(('8.8.8.8', 80))
                ip = s.getsockname()[0]
            except Exception:
                pass
            finally:
                s.close()
            return ip

        # ---- parameter callbacks (reached by the parexec dispatcher) ------------

        def _onScannowPulse(self, par) -> None:
            self.Scan()

        # ---- discovery public API -----------------------------------------------

        def Scan(self) -> None:
            """Start an asynchronous subnet sweep for PJLink projectors."""
            if self._scanning:
                self._setStatus('A scan is already running -- please wait.')
                return
            if self._pjPending > 0:
                self._setStatus('A power command is in progress -- try again in a moment.')
                return
            hosts = self._hostList()
            port = int(self.ownerComp.par.Port.eval())
            timeout_s = max(0.05, int(self.ownerComp.par.Timeoutms.eval()) / 1000.0)
            conc = max(1, int(self.ownerComp.par.Concurrency.eval()))
            self._resultQ = queue.Queue()
            self._progressQ = queue.Queue()
            self._total = len(hosts)
            self._done = 0
            self._scanning = True
            base = hosts[0].rsplit('.', 1)[0] if hosts else '?'
            self._setStatus('Scanning %s.1-254 on port %d ...' % (base, port))
            self._resetTables()
            self._armDrain()
            self._thread = threading.Thread(
                target=ProjectorScannerExt._probeWorker,
                args=(hosts, port, timeout_s, conc, self._resultQ, self._progressQ),
                daemon=True)
            self._thread.start()
            self._updateUiState()

        @staticmethod
        def _probeWorker(hosts, port, timeout_s, conc, resultQ, progressQ) -> None:
            def probe(ip):
                try:
                    s = socket.create_connection((ip, port), timeout=timeout_s)
                except Exception:
                    return None
                banner = ''
                try:
                    s.settimeout(timeout_s)
                    banner = s.recv(64).decode('ascii', 'replace').strip()
                except Exception:
                    banner = ''
                finally:
                    try:
                        s.close()
                    except Exception:
                        pass
                is_proj = banner.upper().startswith('PJLINK')
                auth, seed = '', ''
                if is_proj:
                    parts = banner.split()
                    if len(parts) >= 2:
                        auth = parts[1]
                    if len(parts) >= 3:
                        seed = parts[2]
                return {'ip': ip, 'banner': banner, 'is_projector': is_proj,
                        'auth': auth, 'seed': seed}

            results = []
            try:
                with ThreadPoolExecutor(max_workers=conc) as ex:
                    futs = [ex.submit(probe, ip) for ip in hosts]
                    for f in as_completed(futs):
                        progressQ.put(1)
                        r = f.result()
                        if r is not None:
                            results.append(r)
            except Exception as e:
                resultQ.put(('ERROR', str(e)))
                return
            resultQ.put(('DONE', results))

        # ---- power control public API -------------------------------------------

        def SetPower(self, ip: str, on: bool) -> None:
            """Turn a projector on (True) or to standby (False). Resolves the
            normalized action power.on/power.off to a command via the matched driver,
            then confirms with power.get."""
            if self._scanning:
                self._setStatus('A scan is in progress -- wait before controlling power.')
                return
            self._runAction(ip, 'power.on' if on else 'power.off', 'power')
            # the command's immediate confirm can read the pre-transition state, so
            # re-query shortly after to catch WARM/COOL (which then self-polls to settle)
            run(self.QueryPower, ip, delayFrames=180)   # ~3s
            run(self.QueryPower, ip, delayFrames=480)   # ~8s

        def TogglePower(self, ip: str) -> None:
            """Toggle a projector. Turning OFF needs a confirm (click again within a
            few seconds); COOL/WARM transitions are ignored until they settle."""
            if self._scanning:
                self._setStatus('A scan is in progress -- please wait.')
                return
            if ip in self._pjBusyIps:
                return                                       # a command is already in flight
            now = time.monotonic()
            if now - self._toggleGuard.get(ip, 0.0) < 0.5:   # debounce held clicks
                return
            self._toggleGuard[ip] = now
            cur = self._power.get(ip, '?')
            if cur == '2':
                self._setStatus('Projector %s is cooling down -- please wait.' % ip)
                return
            if cur == '3':
                self._setStatus('Projector %s is warming up -- please wait.' % ip)
                return
            if cur == '1':
                # currently ON: turning OFF requires a second (confirm) click
                if now - self._confirmOff.get(ip, 0.0) < CONFIRM_S:
                    self._confirmOff.pop(ip, None)
                    self.SetPower(ip, False)
                else:
                    self._confirmOff[ip] = now
                    self._setStatus('Click again within %ds to power OFF %s.' % (int(CONFIRM_S), ip))
                    self._refreshIpDisplay()
                    run(self._disarmConfirm, ip, delayFrames=CONFIRM_FRAMES)
                return
            # OFF or unknown: power on (no confirm needed)
            self._confirmOff.pop(ip, None)
            self.SetPower(ip, True)

        def _disarmConfirm(self, ip: str) -> None:
            armed = self._confirmOff.get(ip)
            if armed is not None and time.monotonic() - armed >= CONFIRM_S:
                self._confirmOff.pop(ip, None)
                self._refreshIpDisplay()

        def QueryPower(self, ip: str) -> None:
            """Ask a projector for its current power state (action power.get)."""
            if self._scanning:
                return
            self._runAction(ip, 'power.get', 'power')

        def QueryInfo(self, ip: str) -> None:
            """Fetch static info via normalized actions (manufacturer, model, name,
            PJLink class, lamp hours), each command sourced from the matched driver."""
            if self._scanning:
                return
            self._runInfo(ip)

        def QueryLamp(self, ip: str) -> None:
            """Refresh just the lamp-hour count (action lamp.hours)."""
            if self._scanning:
                return
            self._runAction(ip, 'lamp.hours', 'lamp')

        def ToggleSelect(self, ip: str) -> None:
            """Tick / untick a projector's selection box. onSelect fires every frame
            while the mouse is held, so debounce to one flip per click -- otherwise
            the box flickers on/off and lands on mouse-up parity."""
            now = time.monotonic()
            if now - self._selGuard.get(ip, 0.0) < 0.4:
                return
            self._selGuard[ip] = now
            if ip in self._selected:
                self._selected.discard(ip)
            else:
                self._selected.add(ip)
            self._refreshIpDisplay()

        def _selectedIps(self) -> List[str]:
            proj = self.ownerComp.op('projectors')
            live = []
            if proj is not None:
                for r in range(1, proj.numRows):
                    ip = proj[r, 0].val
                    if ip and ip in self._selected:
                        live.append(ip)
            return live

        def PowerSelected(self, on: bool) -> None:
            """Turn every SELECTED projector on or off. Skips (and reports) any that
            are already in the requested state -- e.g. Selected Off on a projector
            that is already off -- and any mid-transition (cooling/warming)."""
            if self._scanning:
                self._setStatus('A scan is in progress -- please wait.')
                return
            sel = self._selectedIps()
            if not sel:
                self._setStatus('No projectors selected -- tick the Sel box on a row first.')
                return
            target = '1' if on else '0'
            word = 'on' if on else 'off'
            sent, already, trans = [], [], []
            for ip in sel:
                cur = self._power.get(ip, '?')
                if cur == target:
                    already.append(ip)
                elif cur in ('2', '3'):
                    trans.append(ip)
                else:
                    self.SetPower(ip, on)
                    sent.append(ip)
            parts = ['Selected %s: %d sent' % (word.capitalize(), len(sent))]
            if already:
                parts.append('%d already %s (%s)' % (len(already), word, ', '.join(already)))
            if trans:
                parts.append('%d cooling/warming skipped (%s)' % (len(trans), ', '.join(trans)))
            self._setStatus('; '.join(parts) + '.')

        def _ensureDrivers(self):
            """Lazily build the DriverManager plus the transport/parser registries from
            the on-disk drivers/ tree (the single source of truth, imported by path so a
            headless test and TD run the exact same code). The parser/transport NAMES
            are injected into DriverManager, so adding a vendor's adapter in those pure
            modules needs no edit here. Returns the instance or None if unavailable."""
            if self._drivers is not None:
                return self._drivers
            try:
                import os
                import importlib.util
                ddir = os.path.join(project.folder, 'drivers')

                def _loadmod(name):
                    p = os.path.join(ddir, name + '.py')
                    sp = importlib.util.spec_from_file_location('projscanner_' + name, p)
                    m = importlib.util.module_from_spec(sp)
                    sp.loader.exec_module(m)
                    return m
                mod = _loadmod('driver_manager')
                self._parsers = _loadmod('parsers')
                self._transports = _loadmod('transports')
                self._parserFns = dict(self._parsers.REGISTRY)
                self._transportFns = dict(self._transports.REGISTRY)
                dm = mod.DriverManager(ddir,
                                       extra_parsers=self._parsers.names(),
                                       extra_transports=self._transports.names())
                dm.load()
                self._drivers = dm
                if dm.errors:
                    debug('DriverManager load warnings:', dm.errors)
            except Exception as e:
                debug('DriverManager load failed:', e)
                return None
            return self._drivers

        def _device(self, ip: str) -> Dict:
            """Build the normalized device object for one projector from the current
            per-field state plus its matched driver + capabilities."""
            dm = self._ensureDrivers()
            maker = self._maker.get(ip, '')
            model = self._model.get(ip, '')
            matched = dm.match_driver(maker, model, self._pclass.get(ip, '')) if dm else None
            caps = dm.capabilities(matched) if dm else []
            return {
                'ip_address': ip,
                'pjlink_name': self._name.get(ip, ''),
                'manufacturer': maker,
                'model': model,
                'pjlink_class': self._pclass.get(ip, ''),
                'power_state': self._power.get(ip, ''),
                'lamp_hours': self._lamp.get(ip, ''),
                'matched_driver': matched,
                'capabilities': caps,
            }

        def Devices(self) -> List[Dict]:
            """Normalized device object for every discovered projector (in list order)."""
            proj = self.ownerComp.op('projectors')
            out = []
            if proj is not None:
                for r in range(1, proj.numRows):
                    ip = proj[r, 0].val
                    if ip:
                        out.append(self._device(ip))
            return out

        def ExplainDriver(self, ip: str) -> str:
            """Report how the final driver for a projector was constructed: the
            protocol -> vendor -> family -> model chain that matched, and for each
            capability which driver supplied it, its transport, and its provenance.
            Returns a printable string (also written to the textport via debug)."""
            dm = self._ensureDrivers()
            if dm is None:
                return 'Driver system unavailable.'
            maker = self._maker.get(ip, '')
            model = self._model.get(ip, '')
            pcls = self._pclass.get(ip, '')
            text = ('Driver resolution for %s  (manufacturer=%r model=%r pjlink_class=%r)\n%s'
                    % (ip, maker, model, pcls, dm.explain_text(maker, model, pcls)))
            debug(text)
            return text

        def RecordVerification(self, ip: str, capability: str, result: str,
                               disposition: str = 'read_only', raw: str = '',
                               firmware: Optional[str] = None, notes: str = '') -> Optional[str]:
            """Append a verification record (evidence) for a capability test to the
            model's log under drivers/verification/. Evidence is kept SEPARATE from
            the declarative command definitions. disposition is one of
            read_only | reversible | disruptive. Returns the file path, or None."""
            import os
            import json as _json
            import datetime
            if disposition not in ('read_only', 'reversible', 'disruptive'):
                self._setStatus('RecordVerification: disposition must be read_only/reversible/disruptive.')
                return None
            dm = self._ensureDrivers()
            driver = self._driverFor(ip) or 'protocol.pjlink'
            spec = (dm.resolve_action(driver, capability) or {}) if dm else {}
            tp = spec.get('transport') or (dm.transport(driver) if dm else {})
            entry = {
                'driver_id': driver,
                'model': self._model.get(ip, ''),
                'firmware': firmware,
                'capability': capability,
                'transport': '%s:%s' % (tp.get('type', 'pjlink'), tp.get('port', '')),
                'command': spec.get('command'),
                'raw': raw,
                'result': result,
                'timestamp': datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ'),
                'disposition': disposition,
                'tester': 'session',
                'notes': notes,
            }
            try:
                vdir = os.path.join(project.folder, 'drivers', 'verification')
                os.makedirs(vdir, exist_ok=True)
                base = driver.split('.', 1)[1] if '.' in driver else driver
                path = os.path.join(vdir, base + '.json')
                log = []
                if os.path.isfile(path):
                    with open(path, 'r', encoding='utf-8') as f:
                        log = _json.load(f)
                    if not isinstance(log, list):
                        log = []
                log.append(entry)
                with open(path, 'w', encoding='utf-8') as f:
                    _json.dump(log, f, indent=2)
                return path.replace('\\', '/')
            except Exception as e:
                self._setStatus('RecordVerification failed: %s' % e)
                return None

        def _autoRefresh(self) -> None:
            """Timer-driven: re-query every projector's power state so external power
            changes (switched off at the unit, another controller) appear in the UI."""
            if not int(self.ownerComp.par.Autorefresh.eval()):
                return
            if self._scanning or self._pjPending > 0:
                return                                       # skip this tick; stay serial
            proj = self.ownerComp.op('projectors')
            if proj is None:
                return
            ips = [proj[r, 0].val for r in range(1, proj.numRows) if proj[r, 0].val]
            for ip in ips:
                self.QueryPower(ip)
            # lamp hours change slowly -> refresh them on a much longer cadence
            now = time.monotonic()
            if now - self._lastLampRefresh >= int(self.ownerComp.par.Lampsecs.eval()):
                self._lastLampRefresh = now
                for ip in ips:
                    self.QueryLamp(ip)

        # ---- driver-resolved action execution -----------------------------------

        def _driverFor(self, ip: str) -> Optional[str]:
            """The driver_id matched to this projector (generic PJLink is fallback)."""
            dm = self._ensureDrivers()
            if dm is None:
                return None
            return dm.match_driver(self._maker.get(ip, ''), self._model.get(ip, ''),
                                   self._pclass.get(ip, '')) or 'protocol.pjlink'

        def _stepFromSpec(self, spec, dest=None, transport=None):
            """Turn a resolved capability spec into one worker step, or None. The step
            carries its own transport: a per-capability override, else the driver
            default (so PJLink actions use PJLink, ESC/VP21 actions use ESC/VP.net)."""
            if not spec or not spec.get('command'):
                return None
            return {'command': spec['command'], 'parse': spec.get('parse', 'pjlink_text'),
                    'dest': dest, 'transport': spec.get('transport') or transport}

        def _runAction(self, ip: str, action: str, token: str) -> None:
            """Resolve a normalized action to its driver command(s) and run them on
            the PJLink transport. A command action (power.on/off) auto-appends its
            'confirm_with' query so power state refreshes afterwards."""
            dm = self._ensureDrivers()
            driver = self._driverFor(ip)
            spec = dm.resolve_action(driver, action) if dm else None
            if not spec or not spec.get('command'):
                self._setStatus('Action "%s" not supported for %s.' % (action, ip))
                return
            dt = dm.transport(driver)
            if action.endswith(('.get', '.hours', '.query')):
                steps = [self._stepFromSpec(spec, dest=token, transport=dt)]
            else:
                steps = [self._stepFromSpec(spec, transport=dt)]   # command (ack), no dest
                cw = spec.get('confirm_with')
                if cw:
                    steps.append(self._stepFromSpec(dm.resolve_action(driver, cw), dest=token, transport=dt))
            steps = [s for s in steps if s]
            if steps:
                self._startSteps(ip, steps, token)

        def _runInfo(self, ip: str) -> None:
            """Fetch all static info fields in ONE serialized connection sequence,
            each command sourced from the matched driver."""
            dm = self._ensureDrivers()
            driver = self._driverFor(ip)
            if dm is None:
                self._setStatus('Driver system unavailable -- cannot query info.')
                return
            wanted = [('info.manufacturer', 'maker'), ('info.model', 'model'),
                      ('info.name', 'name'), ('info.class', 'class'), ('lamp.hours', 'lamp')]
            dt = dm.transport(driver)
            steps = [self._stepFromSpec(dm.resolve_action(driver, a), dest=d, transport=dt) for a, d in wanted]
            steps = [s for s in steps if s]
            if steps:
                self._startSteps(ip, steps, 'info')

        def _startSteps(self, ip: str, steps: List[Dict], token: str) -> None:
            """Spawn the generic PJLink worker for a resolved list of steps. The parser
            and transport callables are resolved on the main thread (via _ensureDrivers)
            and passed in, so the worker stays pure (no TD, no disk)."""
            self._ensureDrivers()                        # make sure the fn registries are built
            port = int(self.ownerComp.par.Port.eval())
            pw = str(self.ownerComp.par.Password.eval())
            self._pjPending += 1
            self._pjBusyIps.add(ip)
            self._armDrain()
            t = threading.Thread(
                target=ProjectorScannerExt._opWorker,
                args=(ip, port, 2.0, list(steps), pw, self._pjLock, self._powerResultQ, token,
                      dict(self._parserFns), dict(self._transportFns)),
                daemon=True)
            t.start()
            self._refreshIpDisplay()
            self._updateUiState()

        # ---- power worker: NO TouchDesigner access whatsoever -------------------

        @staticmethod
        def _opWorker(ip, port, timeout_s, steps, password, lock, outQ, token,
                      parserFns, transportFns) -> None:
            """Run a resolved list of {command, parse, dest} steps on the serialized
            one-connection-at-a-time transport. Pure Python, NO TD access. Parser and
            transport callables are passed in (from drivers/parsers.py & transports.py)
            and dispatched by name -- no protocol code lives here. Puts (ip, token,
            results) mapping each step's dest to its parsed value ('_error': True on a
            transport failure)."""
            def parse(name, resp):
                fn = parserFns.get(name) or parserFns.get('pjlink_text')
                return fn(resp) if fn else resp

            def txn(st):
                tp = st.get('transport') or {'type': 'pjlink', 'port': port}
                p = int(tp.get('port', port))
                fn = transportFns.get(tp.get('type')) or transportFns.get('pjlink')
                return fn(ip, p, timeout_s, st['command'], {'password': password})

            results = {}
            with lock:  # serialize: one live connection at a time
                try:
                    for i, st in enumerate(steps):
                        if i:
                            time.sleep(0.2)   # free the projector's slot between commands
                        resp = txn(st)
                        val = parse(st.get('parse', 'pjlink_text'), resp)
                        if st.get('dest'):
                            results[st['dest']] = val
                except Exception:
                    results['_error'] = True
            outQ.put((ip, token, results))

        # ---- drain: MAIN THREAD, once per frame while work is in flight ----------

        def pumpResults(self) -> None:
            # discovery progress
            got = 0
            try:
                while True:
                    self._progressQ.get_nowait()
                    got += 1
            except queue.Empty:
                pass
            if got and self._scanning:
                self._done += got
                self._setStatus('Scanning ... %d / %d hosts probed'
                                % (self._done, self._total))
            # discovery result
            try:
                tag, payload = self._resultQ.get_nowait()
            except queue.Empty:
                tag = None
            if tag == 'ERROR':
                self._scanning = False
                self._setStatus('Scan error: %s' % payload)
            elif tag == 'DONE':
                self._scanning = False
                self._writeResults(payload)
            # power results
            drained = False
            while True:
                try:
                    ip, token, results = self._powerResultQ.get_nowait()
                except queue.Empty:
                    break
                drained = True
                self._pjPending = max(0, self._pjPending - 1)
                self._pjBusyIps.discard(ip)
                if token == 'info':
                    self._maker[ip] = results.get('maker') or self._maker.get(ip) or '?'
                    self._model[ip] = results.get('model') or self._model.get(ip) or '?'
                    self._name[ip] = results.get('name') or self._name.get(ip) or '?'
                    self._pclass[ip] = results.get('class') or self._pclass.get(ip) or '?'
                    self._lamp[ip] = results.get('lamp') or self._lamp.get(ip) or '?'
                    self._storeInfo()
                    continue
                if token == 'lamp':
                    self._lamp[ip] = results.get('lamp') or self._lamp.get(ip) or '?'
                    self._storeInfo()
                    continue
                if token != 'power':
                    bucket = self._actionResults.setdefault(ip, {})
                    for k, v in results.items():
                        if k != '_error':
                            bucket[k] = v
                    continue
                # token == 'power'
                code = results.get('power')
                if code in ('0', '1', '2', '3'):
                    self._power[ip] = code
                    self._setStatus('Projector %s power: %s' % (ip, POWER_LABEL.get(code, '?')))
                elif results.get('_error'):
                    self._power[ip] = 'ERR'
                    self._setStatus('Projector %s did not respond to power command.' % ip)
                # keep polling while the projector is transitioning (COOL/WARM)
                if self._power.get(ip) in ('2', '3'):
                    cnt = self._pollCount.get(ip, 0)
                    if cnt < POLL_MAX:
                        self._pollCount[ip] = cnt + 1
                        run(self.QueryPower, ip, delayFrames=POLL_FRAMES)
                else:
                    self._pollCount.pop(ip, None)
            if drained:
                self._refreshIpDisplay()
            # idle when nothing is in flight
            if not self._scanning and self._pjPending <= 0:
                self._disarmDrain()
            self._updateUiState()

        # ---- table writing ------------------------------------------------------

        def _resetTables(self) -> None:
            proj = self.ownerComp.op('projectors')
            allr = self.ownerComp.op('scan_results')
            if proj is not None:
                proj.clear(keepFirstRow=False)
                proj.appendRow(['ip', 'auth', 'seed', 'banner'])
            if allr is not None:
                allr.clear(keepFirstRow=False)
                allr.appendRow(['ip', 'is_projector', 'auth', 'banner'])
            self._refreshIpDisplay()

        def _storeInfo(self) -> None:
            """Persist static-ish projector info so it survives an extension reinit."""
            self.ownerComp.store('info_maker', self._maker)
            self.ownerComp.store('info_model', self._model)
            self.ownerComp.store('info_name', self._name)
            self.ownerComp.store('info_lamp', self._lamp)
            self.ownerComp.store('info_class', self._pclass)

        def _refreshIpDisplay(self) -> None:
            """Mirror the projectors into the UI list source: column 0 = power label,
            column 1 = IP address (header + one row per projector), then refresh the
            on-screen list."""
            disp = self.ownerComp.op('ui/ip_display')
            if disp is not None:
                src = self.ownerComp.op('projectors')
                disp.clear(keepFirstRow=False)
                disp.appendRow(['Sel', 'Power', 'IP Address', 'Name', 'Make', 'Unit', 'Lamp Hrs'])
                if src is not None:
                    for r in range(1, src.numRows):
                        ip = src[r, 0].val
                        if ip:
                            if ip in self._pjBusyIps:
                                label = '...'
                            elif ip in self._confirmOff:
                                label = 'OFF?'
                            else:
                                label = POWER_LABEL.get(self._power.get(ip, '?'), '?')
                            selbox = '[x]' if ip in self._selected else '[ ]'
                            disp.appendRow([selbox, label, ip,
                                            self._name.get(ip) or '?',
                                            self._maker.get(ip) or '?',
                                            self._model.get(ip) or '?',
                                            self._lamp.get(ip) or '?'])
            lst = self.ownerComp.op('ui/ip_list')
            if lst is not None:
                lst.par.cols = 7
                lst.par.rows = disp.numRows if disp is not None else 1
                lst.par.reset.pulse()

        def _writeResults(self, results: List[Dict]) -> None:
            def ipkey(r):
                try:
                    return tuple(int(x) for x in r['ip'].split('.'))
                except Exception:
                    return (999, 999, 999, 999)
            responders = sorted(results, key=ipkey)
            projectors = [r for r in responders if r['is_projector']]

            allr = self.ownerComp.op('scan_results')
            if allr is not None:
                allr.clear(keepFirstRow=False)
                allr.appendRow(['ip', 'is_projector', 'auth', 'banner'])
                for r in responders:
                    allr.appendRow([r['ip'], '1' if r['is_projector'] else '0',
                                    r['auth'], r['banner']])

            proj = self.ownerComp.op('projectors')
            if proj is not None:
                proj.clear(keepFirstRow=False)
                proj.appendRow(['ip', 'auth', 'seed', 'banner'])
                for r in projectors:
                    proj.appendRow([r['ip'], r['auth'], r['seed'], r['banner']])

            self._refreshIpDisplay()
            self._lastLampRefresh = time.monotonic()   # info() just fetched lamp hours
            for r in projectors:              # populate power state + info per projector
                self.QueryPower(r['ip'])
                self.QueryInfo(r['ip'])

            n, m = len(projectors), len(responders)
            if m == 0:
                self._setStatus('Done. No host answered on the PJLink port. Check the '
                                'projector is powered on and on this subnet.')
            elif n == 0:
                self._setStatus('Done. %d host(s) had the port open but none spoke '
                                'PJLink (see scan_results).' % m)
            else:
                self._setStatus('Done. Found %d projector(s). First: %s'
                                % (n, projectors[0]['ip']))
  dat_content_format: text
- name: refresh_timer_callbacks
  type: textDAT
  parameters:
    language: python
  flags:
  - viewer
  - -showDocked
  position: [200, -560]
  size: [130, 90]
  dock: refresh_timer
  dat_content: |
    # refresh_timer: fires onCycle every 'Refresh Interval' seconds while Auto-Refresh
    # is on, re-querying each projector's power state so the list stays accurate.

    def onCycle(timerOp, segment, cycle):
        parent.ProjectorScanner.ext.ProjectorScanner._autoRefresh()
        return
  dat_content_format: text
annotations:
- name: annotate1
  mode: annotate
  title: Projector Discovery + Power (PJLink)
  text: 'Scans the /24 for PJLink projectors (TCP 4352) and controls power. UI viewer: per-row ON/OFF toggle (confirm before OFF) + IP list. Power uses serialized background sockets; refresh_timer re-queries every ~15s so state stays live. tcpip1 (right) is unused.'
  position: [130, -630]
  size: [995, 1090]
  color: [0.45, 0.45, 0.45]
