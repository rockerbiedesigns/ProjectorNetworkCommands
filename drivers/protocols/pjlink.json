{
  "driver_id": "protocol.pjlink",
  "label": "Generic PJLink",
  "protocol": "pjlink",
  "tier": "protocol",
  "extends": null,
  "match": { "always": true },
  "transport": { "type": "pjlink", "port": 4352, "terminator": "\r" },
  "capabilities": {
    "power.on":          { "command": "%1POWR 1", "kind": "command", "parse": "pjlink_ack", "confirm_with": "power.get",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "power.off":         { "command": "%1POWR 0", "kind": "command", "parse": "pjlink_ack", "confirm_with": "power.get",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "power.get":         { "command": "%1POWR ?", "kind": "query", "parse": "pjlink_power",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "input.get":         { "command": "%1INPT ?", "kind": "query", "parse": "pjlink_text",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "info.manufacturer": { "command": "%1INF1 ?", "kind": "query", "parse": "pjlink_text",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "info.model":        { "command": "%1INF2 ?", "kind": "query", "parse": "pjlink_text",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "info.name":         { "command": "%1NAME ?", "kind": "query", "parse": "pjlink_text",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "info.class":        { "command": "%1CLSS ?", "kind": "query", "parse": "pjlink_text",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } },
    "lamp.hours":        { "command": "%1LAMP ?", "kind": "query", "parse": "pjlink_lamp",
                           "meta": { "provenance": "documented", "source": { "title": "PJLink Class 1 Specification (JBMIA)", "url": "https://pjlink.jbmia.or.jp/english/" } } }
  }
}
