{
  "driver_id": "model.epson.eb410w",
  "label": "Epson EB-410W / PowerLite 410W",
  "protocol": "pjlink",
  "tier": "model",
  "extends": "vendor.epson",
  "match": {
    "manufacturer_contains": "epson",
    "model_contains": "410w",
    "model_aliases": ["eb-410w", "powerlite 410w"],
    "pjlink_class": "1"
  },
  "capabilities": {
    "power.get":   { "command": "%1POWR ?", "kind": "query", "parse": "pjlink_power",
                     "meta": { "provenance": "hardware_verified",
                               "source": { "title": "Live read vs unit 192.168.50.190", "version": "2026-10-01" } } },
    "input.get":   { "command": "SOURCE?", "kind": "query", "parse": "escvp_val", "transport": { "type": "esc_vp21", "port": 3629 },
                     "meta": { "provenance": "hardware_verified",
                               "source": { "title": "Live read vs unit 192.168.50.190; SOURCE code map established (14=Computer1/vga1, 21=Computer2/vga2, 42=S-Video, 41=Composite)", "version": "2026-10-05" } } },
    "input.set":   { "command": "SOURCE {value}", "kind": "set", "parse": "escvp_ack", "transport": { "type": "esc_vp21", "port": 3629 },
                     "value_map": { "vga1": "14", "vga2": "21", "svideo": "42", "composite": "41" },
                     "meta": { "provenance": "hardware_verified",
                               "source": { "title": "Live set+readback vs unit 192.168.50.190: each SOURCE code set and confirmed by SOURCE? (this unit has no HDMI; Computer1 is auto-sensing, no separate RGB code)", "version": "2026-10-05" } } },
    "av.mute.get": { "command": "MUTE?", "kind": "query", "parse": "escvp_val", "transport": { "type": "esc_vp21", "port": 3629 },
                     "meta": { "provenance": "hardware_verified",
                               "source": { "title": "Live read vs unit 192.168.50.190 (MUTE?=OFF)", "version": "2026-10-01" } } }
  }
}
